{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(resilience_payment_requests_total[1m]))", "legendFormat": "Paiements/s", "refId": "A" }],
      "title": "Débit des paiements",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "sum(rate(resilience_payment_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(resilience_payment_requests_total[1m])), 0.001)", "legendFormat": "Ratio HTTP 5xx", "refId": "A" }],
      "title": "Taux d'échec des paiements",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(resilience_payment_duration_seconds_sum[1m])) / clamp_min(sum(rate(resilience_payment_duration_seconds_count[1m])), 0.001)", "legendFormat": "Latence moyenne", "refId": "A" }],
      "title": "Latence des paiements",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "{app=\"payment-api\"} | json | type=~\"incident|detection|remediation|recovery|recovery_failed|payment_failed|authorization_denied\"", "refId": "A" }],
      "title": "Chronologie des incidents, décisions et reprises",
      "type": "logs"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "text": "Nominal" }, "1": { "text": "Incident actif" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "id": 5,
      "targets": [{ "expr": "resilience_incident_active", "refId": "A" }],
      "title": "État de l'incident",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "text": "Aucune anomalie" }, "1": { "text": "Anomalie ML" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 16 },
      "id": 6,
      "targets": [{ "expr": "resilience_model_anomaly", "refId": "A" }],
      "title": "Décision du détecteur ML",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "text": "À vérifier" }, "1": { "text": "Reprise vérifiée" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 16 },
      "id": 7,
      "targets": [{ "expr": "resilience_recovery_verified", "refId": "A" }],
      "title": "Vérification métier après reprise",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 16 },
      "id": 8,
      "targets": [{ "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "Alertes actives", "refId": "A" }],
      "title": "Alertes Prometheus actives",
      "type": "stat"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["resilience-alpha", "payments"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Resilience Alpha — Service Paiement",
  "uid": "resilience-alpha",
  "version": 1
}
